<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 第 2 步最小演示工程：心跳消息 生产 + 消费 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.uav</groupId>
    <artifactId>heartbeat-demo</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>heartbeat-demo</name>
    <description>设备仿真心跳消息 Kafka 生产消费演示</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- Web：让应用保持常驻并提供 HTTP（否则无守护线程的进程可能直接退出） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 第 3 步：MongoDB 持久化（Spring Data MongoDB） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>
        <!-- Spring 对 Kafka 的封装：KafkaTemplate + @KafkaListener -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
